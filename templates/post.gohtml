<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script async src="https://www.googletagmanager.com/gtag/js?id={{.GAID}}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{.GAID}}');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{.Title}} | Özgür Tanrıverdi (otrv)</title>
    {{if .Description}}<meta name="description" content="{{.Description}}" />{{end}}
    <meta name="author" content="Özgür Tanrıverdi" />
    <meta name="robots" content="max-image-preview:large" />
    <meta property="og:title" content="{{.Title}}" />
    {{if .Description}}<meta property="og:description" content="{{.Description}}" />{{end}}
    <meta property="og:site_name" content="otrv.dev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://otrv.dev/{{.Slug}}.html" />
    <meta property="article:author" content="https://otrv.dev/" />
    <meta property="article:published_time" content="{{.DateRFC3339}}" />
    <meta property="og:image" content="https://otrv.dev/{{.SocialImage}}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{.Title}} — Özgür Tanrıverdi. otrv.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{.Title}}" />
    {{if .Description}}<meta name="twitter:description" content="{{.Description}}" />{{end}}
    <meta name="twitter:image" content="https://otrv.dev/{{.SocialImage}}" />
    <meta name="twitter:image:alt" content="{{.Title}} — Özgür Tanrıverdi. otrv.dev" />
    <meta name="twitter:site" content="@otrv45" />
    <meta name="twitter:creator" content="@otrv45" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="canonical" href="https://otrv.dev/{{.Slug}}.html" />
    <link rel="alternate" type="application/atom+xml" title="Özgür Tanrıverdi (otrv)" href="https://otrv.dev/feed.xml" />
    <link rel="stylesheet" href="/main.css" />
    <script type="application/ld+json">{{.JSONLD}}</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a href="/" class="nav-name">otrv</a>
        <a href="/#posts">← posts</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <article>
        <header class="post-header">
          <h1>{{.Title}}</h1>
          <time datetime="{{.DateISO}}">{{.DateString}}</time>
          {{if .Description}}<p class="post-description">{{.Description}}</p>{{end}}
        </header>
        {{if .Cover}}<img src="/{{.Cover}}" alt="{{.Title}}" class="cover" />{{end}}
        <div class="prose">{{.Content}}</div>
      </article>
      <aside class="author-footer" aria-label="About the author">
        <img src="/me.jpeg" alt="Özgür Tanrıverdi" class="footer-avatar" width="48" height="48" loading="lazy" />
        <div>
          <p>Özgür Tanrıverdi</p>
          <p>I am a software engineer based in Istanbul who obsesses over pragmatic problem solving.</p>
        </div>
      </aside>
    </main>
    <footer class="site-footer">
      <nav class="social-links" aria-label="Elsewhere">
        <a href="https://github.com/otrv">github</a>
        <a href="https://x.com/otrv45">twitter</a>
        <a href="https://linkedin.com/in/otrv">linkedin</a>
        <a href="/feed.xml">rss</a>
      </nav>
      <p>Code licensed under MIT.</p>
    </footer>
  </body>
</html>
