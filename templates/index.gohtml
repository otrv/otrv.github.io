<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script async src="https://www.googletagmanager.com/gtag/js?id={{.GAID}}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{.GAID}}');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Özgür Tanrıverdi (otrv) | Software engineer</title>
    <meta name="description" content="Notes on software engineering, state, and pragmatic problem solving by Özgür Tanrıverdi, a software engineer in Istanbul." />
    <meta name="author" content="Özgür Tanrıverdi" />
    <meta name="robots" content="max-image-preview:large" />
    <meta property="og:title" content="Özgür Tanrıverdi (otrv) | Software engineer" />
    <meta property="og:description" content="Notes on software engineering, state, and pragmatic problem solving by Özgür Tanrıverdi, a software engineer in Istanbul." />
    <meta property="og:site_name" content="otrv.dev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://otrv.dev/" />
    <meta property="og:image" content="https://otrv.dev/social-index.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Özgür Tanrıverdi — Software engineer in Istanbul. otrv.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Özgür Tanrıverdi (otrv) | Software engineer" />
    <meta name="twitter:description" content="Notes on software engineering, state, and pragmatic problem solving by Özgür Tanrıverdi, a software engineer in Istanbul." />
    <meta name="twitter:image" content="https://otrv.dev/social-index.png" />
    <meta name="twitter:image:alt" content="Özgür Tanrıverdi — Software engineer in Istanbul. otrv.dev" />
    <meta name="twitter:site" content="@otrv45" />
    <meta name="twitter:creator" content="@otrv45" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="canonical" href="https://otrv.dev/" />
    <link rel="alternate" type="application/atom+xml" title="Özgür Tanrıverdi (otrv)" href="https://otrv.dev/feed.xml" />
    <link rel="stylesheet" href="/main.css" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://otrv.dev/#website",
            "url": "https://otrv.dev/",
            "name": "otrv.dev",
            "alternateName": "Özgür Tanrıverdi",
            "inLanguage": "en",
            "author": {"@id": "https://otrv.dev/#person"}
          },
          {
            "@type": "Person",
            "@id": "https://otrv.dev/#person",
            "name": "Özgür Tanrıverdi",
            "alternateName": "otrv",
            "url": "https://otrv.dev/",
            "image": "https://otrv.dev/me.jpeg",
            "jobTitle": "Software engineer",
            "sameAs": ["https://github.com/otrv", "https://x.com/otrv45", "https://linkedin.com/in/otrv"]
          }
        ]
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <nav aria-label="Home">
        <a href="/" class="nav-name" aria-current="page">otrv</a>
        <span aria-hidden="true">~</span>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <section class="intro" aria-labelledby="name">
        <h1 id="name">Özgür Tanrıverdi</h1>
        <p>I am a software engineer based in Istanbul who obsesses over pragmatic problem solving.</p>
        <nav class="social-links" aria-label="Elsewhere">
          <a href="https://github.com/otrv">github</a>
          <a href="https://x.com/otrv45">twitter</a>
          <a href="https://linkedin.com/in/otrv">linkedin</a>
          <a href="/feed.xml">rss</a>
        </nav>
      </section>
      <section class="writing" aria-labelledby="posts">
        <h2 id="posts">posts/</h2>
        <ul class="post-list">
          {{range .Posts}}
          <li>
            <time datetime="{{.DateISO}}">{{.DateString}}</time>
            <a href="/{{.Slug}}.html">{{.Title}}</a>
          </li>
          {{end}}
        </ul>
      </section>
    </main>
    <footer class="site-footer">
      <p>Code licensed under MIT.</p>
    </footer>
  </body>
</html>
